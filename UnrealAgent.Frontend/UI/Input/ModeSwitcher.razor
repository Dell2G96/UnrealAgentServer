@using UnrealAgent.Backend.Mode

<!-- 모드 스위처입니다. Shift+Tab으로 전환되며, 입력창 바로 아래에 항상 표시됩니다. -->
<div class="flex items-center">
    <div class="flex items-center gap-0.5 bg-kk-chip p-0.5 rounded-lg border border-kk-line h-7">
        @foreach (AgentMode Mode in Enum.GetValues<AgentMode>())
        {
            bool bIsActive = (Mode == CurrentMode);
            <button type="button" @onclick="() => SetMode(Mode)"
                    class="flex items-center gap-1.5 px-3 h-full rounded-md transition-all
                           @(bIsActive
                               ? "bg-kk-bar border border-kk-line shadow-sm"
                               : "border border-transparent opacity-70 hover:opacity-100")">
                <span class="w-1.5 h-1.5 rounded-full @DotColor(Mode, bIsActive)"></span>
                <span class="text-[9px] font-bold uppercase tracking-wider @TextColor(Mode, bIsActive)">
                    @Mode.ToString()
                </span>
            </button>

            @if (Mode != AgentMode.Plan)
            {
                <div class="w-px h-3 bg-kk-line"></div>
            }
        }
    </div>
    <!-- 전환 단축키 안내 -->
    <span class="ml-2 text-[9px] text-kk-icon font-mono tracking-wide select-none">Shift+Tab</span>
</div>