<!-- 카카오톡 스타일 상단바 (흰 배경 + 어두운 글자) -->
<header class="flex items-center justify-between whitespace-nowrap border-b border-kk-line bg-kk-bar px-4 py-2.5 shrink-0 z-30">

    <!-- 좌측 : 프로필 + 채팅방 이름
         카톡의 뒤로가기(←) 버튼은 돌아갈 화면이 없어 넣지 않았다. -->
    <div class="flex items-center gap-2.5">
        <div class="size-8 flex items-center justify-center rounded-xl bg-kk-avatar overflow-hidden">
            <span class="font-sans font-black text-white text-sm leading-none">U</span>
        </div>
        <h2 class="text-[15px] font-semibold text-kk-text tracking-tight">
            UnrealAgent
            <span class="text-[10px] bg-kk-chip px-1.5 py-0.5 rounded text-kk-time ml-1.5 font-mono tracking-wide align-middle">Dell2g</span>
        </h2>
    </div>

    <!-- 우측 : 설정 (카톡의 햄버거 메뉴 자리) -->
    <div class="flex items-center gap-1">
        <button @onclick="OnSettingsClick"
                class="relative group flex items-center justify-center size-8 rounded-lg hover:bg-kk-chip transition-colors text-kk-icon hover:text-kk-text">
            <span class="material-symbols-outlined text-[20px]">settings</span>
            <div class="absolute top-full right-0 mt-2 w-44 p-2.5 bg-kk-bar border border-kk-line rounded-lg shadow-lg text-[10px] z-50 pointer-events-none opacity-0 group-hover:opacity-100 transition-all duration-200">
                <div class="text-kk-text font-medium leading-tight text-center">API Key 인증 관리</div>
                <div class="absolute top-[-5px] right-2.5 w-2.5 h-2.5 bg-kk-bar border-t border-l border-kk-line rotate-45"></div>
            </div>
        </button>
    </div>
</header>
