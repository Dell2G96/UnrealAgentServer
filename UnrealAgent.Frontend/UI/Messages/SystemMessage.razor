<!-- 시스템 메시지 배너입니다. -->
<!-- 26.11.02 whitespace-pre-line : /usage 출력처럼 여러 줄인 메시지의 줄바꿈 유지 -->
<div class="flex justify-center z-10 msg-enter">
    <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded border shadow-sm text-[#e05e5e] bg-[#2a1515] border-[#5a2a2a] whitespace-pre-line">
        @Message.Content
    </span>
</div>